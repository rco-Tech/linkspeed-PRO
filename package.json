{
  "name": "linkspeed-pro",
  "productName": "LinkSpeed Pro",
  "version": "1.1.7",
  "description": "LinkSpeed Pro — 1-Click Desktop App & PWA for USB Cable Negotiated Speed & Hardware Inspection",
  "main": "electron-main.js",
  "bin": {
    "linkspeed": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "desktop:mac": "electron .",
    "dev": "node server.js",
    "dist": "electron-builder -p never",
    "dist:mac": "electron-builder --mac -p never",
    "dist:linux": "electron-builder --linux -p never",
    "dist:win": "electron-builder --win -p never"
  },
  "keywords": [
    "usb",
    "link-speed",
    "usb-c",
    "thunderbolt",
    "pwa",
    "electron",
    "hardware-inspector",
    "system-profiler"
  ],
  "author": "rco-Tech <rco.technology@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.rcotech.linkspeedpro",
    "productName": "LinkSpeed Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "server.js",
      "package.json",
      "public/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "public/icons/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "LinkSpeed Pro ${version}",
      "contents": [
        {
          "x": 140,
          "y": 240
        },
        {
          "x": 420,
          "y": 240,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 560,
        "height": 400
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "public/icons/icon-512.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icons/icon-512.png"
    }
  }
}
